<?xml version="1.0" encoding="utf-8"?>
<!-- 目标进度环（浅色）：细环轨道 + 270° 起笔的进度弧 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="ring" android:useLevel="false"
            android:innerRadius="26dp" android:thickness="6dp">
            <solid android:color="#EBEAE4" />
        </shape>
    </item>
    <item>
        <rotate android:fromDegrees="270" android:toDegrees="630">
            <shape android:shape="ring" android:useLevel="true"
                android:innerRadius="26dp" android:thickness="6dp">
                <solid android:color="#17171B" />
            </shape>
        </rotate>
    </item>
</layer-list>
